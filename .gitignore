# No credentials, ever.
*.env
.env*
*secret*
*credential*
*token*
*.key
*.pem
config/*.local.*

# No hostnames, usernames or keys in this repo. Real configs stay local;
# only the *.example.toml templates are committed.
config/*.toml
!config/*.example.toml
config/*.sh
!config/*.example.sh
applications/
llm_api.toml
cluster.toml

# Local operating rules — readable, never pushed. Names infrastructure details.
CLAUDE.md

# No corpus data in git — corpora are licensed/DUA-bound and some are personal data.
#
# data/ is ignored WHOLESALE and re-admitted piece by piece, for the same reason results/ is
# below. The old rules named only data/corpora/ and data/raw/, which left data/conditionA/
# exposed — it holds enron_A.jsonl.gz, 36 MB of real names from a non-consenting corpus. Since
# 2026-09-26 the cluster work directory is a checkout of this repository, and this repository is
# public, so a single `git add -A` run there would have published that file.
data/*
!data/*.md
*.zip
*.tar.gz

# The cluster work directory holds these and this repository must never carry them: model and
# dataset caches, the virtualenv, job logs, and the staging directories.
hf_cache/
models/
logs/
_stage/
_sync/
/*.log
/*.jsonl

# Third-party agreement forms and generated fill-in sheets: local only.
applications/forms/

# Artefacts.
#
# results/ is ignored WHOLESALE and re-admitted piece by piece. The reason is concrete: the detector
# cache stores each detected span's *verbatim text*, so results/detector_cache/cardiode/ holds
# 126,856 CARDIO:DE span strings — 1,572,267 characters, about a third of that corpus — and Enron's
# cache holds live personal data from a non-consenting corpus. The old rules ignored only
# results/*.csv and results/*.parquet, so a single `git add results/` would have committed
# DUA-restricted clinical text into a repository the plan intends to release publicly.
results/
!results/*.md
# ...and experiments/results/ is not that tree. The rule above has no leading slash, so it matches
# at any depth, and it was silently swallowing the small summary artefacts that do belong here —
# enron_leak_ablation.json was skipped by `git add experiments/` on 2026-09-25 without a word.
!experiments/results/
__pycache__/
.venv/
*.pyc
.DS_Store

# Python venv (local, not shared)
.venv/
*.egg-info/
.pytest_cache/

# LaTeX build artefacts — main.pdf is derived; a binary in the history makes every diff worse.
paper/*.aux
paper/*.bbl
paper/*.blg
paper/*.fdb_latexmk
paper/*.fls
paper/*.log
paper/*.out
paper/*.pdf
# ...except the built paper itself: AM reviews it from the remote (2026-09-25).
!paper/main.pdf
paper/*.synctex.gz
paper/*.toc
paper/*.lof
paper/*.lot

# No credentials, ever.
*.env
.env*
*secret*
*credential*
*token*
*.key
*.pem
config/*.local.*

# No hostnames, usernames or keys in this repo. Real configs stay local;
# only the *.example.toml templates are committed.
config/*.toml
!config/*.example.toml
config/*.sh
!config/*.example.sh
applications/
llm_api.toml
cluster.toml

# Local operating rules — readable, never pushed. Names infrastructure details.
CLAUDE.md

# No corpus data in git — corpora are licensed/DUA-bound and some are personal data.
data/corpora/
data/raw/
*.zip
*.tar.gz

# Third-party agreement forms and generated fill-in sheets: local only.
applications/forms/

# Artefacts.
#
# results/ is ignored WHOLESALE and re-admitted piece by piece. The reason is concrete: the detector
# cache stores each detected span's *verbatim text*, so results/detector_cache/cardiode/ holds
# 126,856 CARDIO:DE span strings — 1,572,267 characters, about a third of that corpus — and Enron's
# cache holds live personal data from a non-consenting corpus. The old rules ignored only
# results/*.csv and results/*.parquet, so a single `git add results/` would have committed
# DUA-restricted clinical text into a repository the plan intends to release publicly.
results/
!results/*.md
__pycache__/
.venv/
*.pyc
.DS_Store

# Python venv (local, not shared)
.venv/
*.egg-info/
.pytest_cache/

# LaTeX build artefacts — main.pdf is derived; a binary in the history makes every diff worse.
paper/*.aux
paper/*.bbl
paper/*.blg
paper/*.fdb_latexmk
paper/*.fls
paper/*.log
paper/*.out
paper/*.pdf
# ...except the built paper itself: AM reviews it from the remote (2026-09-25).
!paper/main.pdf
paper/*.synctex.gz
paper/*.toc
paper/*.lof
paper/*.lot
